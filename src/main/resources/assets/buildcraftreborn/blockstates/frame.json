{
  "multipart": [
    {"apply": {"model": "buildcraftreborn:block/frame_base"}},
    {"when": {"north": "true"}, "apply": {"model": "buildcraftreborn:block/frame_connection"}},
    {"when": {"south": "true"}, "apply": {"model": "buildcraftreborn:block/frame_connection", "y": 180}},
    {"when": {"east": "true"}, "apply": {"model": "buildcraftreborn:block/frame_connection", "y": 90}},
    {"when": {"west": "true"}, "apply": {"model": "buildcraftreborn:block/frame_connection", "y": 270}},
    {"when": {"up": "true"}, "apply": {"model": "buildcraftreborn:block/frame_connection", "x": 270}},
    {"when": {"down": "true"}, "apply": {"model": "buildcraftreborn:block/frame_connection", "x": 90}}
  ]
}
